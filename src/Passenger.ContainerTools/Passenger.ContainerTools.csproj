<Project Sdk="Microsoft.NET.Sdk">
  <!-- Passenger's container tools: what runs inside a Linux container for the IDE outside it, over docker exec's standard
       input and output. One executable with modes: dap (the IDE's own debug adapter, the same engine, compiled in from
       Passenger.DebugAdapter), processes (the container's .NET programs as JSON), and the profiler's trace, heap and
       sources (Passenger.Profiler's InContainer, ClrMD reading a heap with the container's own DAC). Published
       self-contained for linux-x64, linux-arm64, linux-musl-x64 and linux-musl-arm64 (just container-tools, the release's
       Passenger-container-tools-<rid>.tar.gz), so it needs nothing of the image but the C library. The IDE never carries
       it: a dev build finds artifacts/container-tools/<rid>/, a release downloads its own version's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>passenger-tools</AssemblyName>
    <RootNamespace>Passenger.ContainerTools</RootNamespace>
    <!-- No ICU in a container's image is needed: the debugger formats nothing by culture (the program's own ToString runs
         in the program), and Alpine's .NET images carry none. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Its own runtime goes with it into the container: the program's may be another version, or none (self-contained). -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <!-- Microsoft.Diagnostics.DbgShim brings one package a system, and for a musl system both its own and the glibc one's
       libdbgshim.so match (musl's systems derive from linux's), the glibc one winning the publish's conflict: it needs
       ld-linux, which Alpine lacks. A musl publish keeps its own. -->
  <Target Name="KeepMuslDbgShim" AfterTargets="ResolvePackageAssets" Condition="$(RuntimeIdentifier.StartsWith('linux-musl-'))">
    <PropertyGroup>
      <GlibcDbgShim>Microsoft.Diagnostics.DbgShim.$(RuntimeIdentifier.Replace('-musl', ''))</GlibcDbgShim>
    </PropertyGroup>
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == '$(GlibcDbgShim)'" />
    </ItemGroup>
  </Target>

  <!-- LICENSE.txt and THIRD-PARTY-NOTICES.txt go with the tools in every build and publish, as with the app, the notices
       written by tools/Passenger.Notices from what the tools' .deps.json names, as the runtime loads it: the runtime pack a
       publish carries, the debugger's and the profiler's packages (ClrMD and its Azure ones, TraceEvent, Roslyn's
       expression compiler, ILSpy's decompiler) and dbgshim for the tools' system (musl's own, KeepMuslDbgShim), each with
       its copyright, licence text and own notices, then THIRD_PARTY_NOTICES.md's sections of the debugger's copied source.
       A package whose licence it cannot write fails the build. The deps file is written just before the output is copied,
       so the notices are written after it, straight into the output, and a publish takes them from there. -->
  <ItemGroup>
    <ProjectReference Include="../../tools/Passenger.Notices/Passenger.Notices.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="ToolsNoticeInputs">
    <MSBuild Projects="../../tools/Passenger.Notices/Passenger.Notices.csproj" Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="NoticesTool" />
    </MSBuild>
    <PropertyGroup>
      <NoticesFile>$([MSBuild]::NormalizePath('$(OutDir)', 'THIRD-PARTY-NOTICES.txt'))</NoticesFile>
      <NoticesArguments>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'notices.txt'))</NoticesArguments>
      <NoticesHost>$(DOTNET_HOST_PATH)</NoticesHost>
      <NoticesHost Condition="'$(NoticesHost)' == ''">dotnet</NoticesHost>
      <NoticesRepository>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</NoticesRepository>
    </PropertyGroup>
    <ItemGroup>
      <NoticeText Include="$(NoticesRepository)THIRD_PARTY_NOTICES.md;$(NoticesRepository)LICENSE;$(NoticesRepository)tools/Passenger.Notices/Licenses/*.txt" />
      <NoticeLine Include="for=tools" />
      <NoticeLine Include="out=$(NoticesFile)" />
      <NoticeLine Include="license=$(NoticesRepository)LICENSE" />
      <NoticeLine Include="notices=$(NoticesRepository)THIRD_PARTY_NOTICES.md" />
      <NoticeLine Include="licenses=$(NoticesRepository)tools/Passenger.Notices/Licenses" />
      <NoticeLine Include="packages=$(NuGetPackageRoot)" />
      <NoticeLine Include="tools=$(ProjectDepsFilePath)" />
      <NoticeLine Include="section=SharpDbg and ICorDebugSharp" />
      <NoticeLine Include="section=Code from ILSpy and ClrDebug" />
    </ItemGroup>
    <WriteLinesToFile File="$(NoticesArguments)" Lines="@(NoticeLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(NoticesFile)" />
    </ItemGroup>
  </Target>

  <Target Name="WriteToolsNotices" AfterTargets="GenerateBuildDependencyFile" DependsOnTargets="ToolsNoticeInputs"
          Inputs="$(NoticesArguments);@(NoticesTool);@(NoticeText);$(ProjectDepsFilePath)" Outputs="$(NoticesFile)">
    <Exec Command="&quot;$(NoticesHost)&quot; &quot;@(NoticesTool)&quot; &quot;$(NoticesArguments)&quot;" />
  </Target>

  <Target Name="PublishToolsNotices" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="ToolsNoticeInputs">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(NoticesFile)" RelativePath="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="../Passenger.DebugAdapter/AdapterProgram.cs" Link="DebugAdapter/AdapterProgram.cs" />
    <Compile Include="../Passenger.DebugAdapter/DebugAdapter.cs" Link="DebugAdapter/DebugAdapter.cs" />
    <ProjectReference Include="../Passenger.Dap/Passenger.Dap.csproj" />
    <ProjectReference Include="../Passenger.Debugger/Passenger.Debugger.csproj" />
    <ProjectReference Include="../Passenger.Profiler/Passenger.Profiler.csproj" />
  </ItemGroup>
</Project>
