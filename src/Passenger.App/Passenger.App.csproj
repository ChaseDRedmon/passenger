<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Passenger</AssemblyName>
    <RootNamespace>Passenger.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- PathNames calls libc's realpath through a generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon; Passenger.icns is the macOS bundle's (tools/package-mac.sh), both from Assets/passenger.svg. -->
    <AvaloniaResource Include="Assets/passenger.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- The screenshot mode's off-screen platform (Screenshot.cs). -->
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <!-- The Model Context Protocol server (Mcp/), the official SDK's core, without its ASP.NET half. -->
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.TestPlatform.TranslationLayer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Passenger.Core/Passenger.Core.csproj" />
    <ProjectReference Include="../Passenger.Editor/Passenger.Editor.csproj" />
    <ProjectReference Include="../Passenger.Languages/Passenger.Languages.csproj" />
    <ProjectReference Include="../Passenger.Lsp/Passenger.Lsp.csproj" />
    <ProjectReference Include="../Passenger.Text/Passenger.Text.csproj" />
    <ProjectReference Include="../Passenger.Terminal/Passenger.Terminal.csproj" />
    <ProjectReference Include="../Passenger.Profiler/Passenger.Profiler.csproj" />
    <ProjectReference Include="../Passenger.Dap/Passenger.Dap.csproj" />
    <!-- Built first and carried, never linked: the adapter runs in its own process. -->
    <ProjectReference Include="../Passenger.DebugAdapter/Passenger.DebugAdapter.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- TraceEvent's props give every build it is in its Windows-only natives (msdia140, KernelTraceControl) under x86/,
       amd64/ and arm64/, since the profiler's own build is for any processor; a publish for another system leaves
       them out. -->
  <Target Name="LeaveOutWindowsTraceNatives" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win-'))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'msdia140' Or $([System.String]::Copy('%(Filename)').StartsWith('KernelTraceControl'))" />
    </ItemGroup>
  </Target>

  <!-- The debug adapter's output becomes this project's output items under debugger/, so every project that
       references this one (the tests) gets it beside its own binaries, as the roslyn/ server comes. -->
  <Target Name="IncludeDebugAdapter" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="../Passenger.DebugAdapter/Passenger.DebugAdapter.csproj" Targets="GetTargetPath" BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="DebugAdapterAssembly" />
    </MSBuild>
    <PropertyGroup>
      <DebugAdapterFolder>@(DebugAdapterAssembly->'%(RootDir)%(Directory)')</DebugAdapterFolder>
    </PropertyGroup>
    <ItemGroup>
      <DebugAdapterFile Include="$(DebugAdapterFolder)**/*" />
      <None Include="@(DebugAdapterFile)" Link="debugger/%(DebugAdapterFile.RecursiveDir)%(DebugAdapterFile.Filename)%(DebugAdapterFile.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
