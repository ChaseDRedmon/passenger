<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:explorer="using:Passenger.App.Explorer"
        xmlns:editors="using:Passenger.App.Editors"
        xmlns:tools="using:Passenger.App.ToolWindows"
        x:Class="Passenger.App.MainWindow"
        Title="Passenger"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        Background="{DynamicResource Passenger.Editor.Background}">
    <Panel>
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The toolbar. On macOS it is also the title bar, so its empty space drags the window. -->
        <Border Name="Toolbar" Grid.Row="0" Height="40"
                Background="{DynamicResource Passenger.Chrome}"
                BorderBrush="{DynamicResource Passenger.Divider}" BorderThickness="0,0,0,1"
                PointerPressed="OnToolbarPressed">
            <DockPanel Name="ToolbarContent" Margin="8,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="widget" ToolTip.Tip="Open a solution, project or folder" Click="OnOpenClicked">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Border Name="ProjectBadge" IsVisible="False" Width="20" Height="20" CornerRadius="4"
                                    Background="{DynamicResource Passenger.Badge}">
                                <TextBlock Name="ProjectBadgeText" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource Passenger.AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Name="ProjectName" Text="No solution" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="widget" ToolTip.Tip="Version control">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Branch}" />
                            <TextBlock Text="Version control" VerticalAlignment="Center" />
                            <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Name="BuildButton" Classes="tool" ToolTip.Tip="Build solution" Click="OnBuildClicked">
                        <PathIcon Data="{StaticResource Icon.Build}" />
                    </Button>
                    <Button Name="RunConfigButton" Classes="widget" ToolTip.Tip="Run configuration" Click="OnRunConfigClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Name="RunConfigName" Text="No configurations" VerticalAlignment="Center" />
                            <PathIcon Classes="chevron" Data="{StaticResource Icon.ChevronDown}" />
                        </StackPanel>
                    </Button>
                    <Button Name="RunButton" Classes="tool" ToolTip.Tip="Run" Click="OnRunClicked">
                        <PathIcon Data="{StaticResource Icon.Run}" Foreground="{DynamicResource Passenger.Run}" />
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="Debug" Click="OnDebugClicked">
                        <PathIcon Data="{StaticResource Icon.Debug}" />
                    </Button>
                    <Button Name="StopButton" Classes="tool" ToolTip.Tip="Stop" IsVisible="False" Click="OnStopClicked">
                        <PathIcon Data="{StaticResource Icon.Stop}" Foreground="{DynamicResource Passenger.Editor.Error}" />
                    </Button>
                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Passenger.Hover}" />
                    <Button Classes="tool" ToolTip.Tip="Search everywhere">
                        <PathIcon Data="{StaticResource Icon.Search}" />
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="Settings">
                        <PathIcon Data="{StaticResource Icon.Settings}" />
                    </Button>
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="40,*,40">

            <!-- The left stripe: tool windows that dock left (top group) and at the bottom (bottom group). -->
            <Border Grid.Column="0" Background="{DynamicResource Passenger.Chrome}"
                    BorderBrush="{DynamicResource Passenger.Divider}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,6">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" HorizontalAlignment="Center">
                        <ToggleButton Name="ExplorerStripe" Classes="stripe" IsChecked="True" ToolTip.Tip="Explorer" Click="OnExplorerStripe">
                            <PathIcon Data="{StaticResource Icon.Explorer}" />
                        </ToggleButton>
                        <ToggleButton Classes="stripe" ToolTip.Tip="Structure">
                            <PathIcon Data="{StaticResource Icon.Structure}" />
                        </ToggleButton>
                        <ToggleButton Classes="stripe" ToolTip.Tip="Commit">
                            <PathIcon Data="{StaticResource Icon.Branch}" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <ToggleButton Name="RunStripe" Classes="stripe" ToolTip.Tip="Run" Tag="Run" Click="OnBottomStripe">
                            <PathIcon Data="{StaticResource Icon.RunOutline}" />
                        </ToggleButton>
                        <ToggleButton Name="BuildStripe" Classes="stripe" ToolTip.Tip="Build" Tag="Build" Click="OnBottomStripe">
                            <PathIcon Data="{StaticResource Icon.Build}" />
                        </ToggleButton>
                        <ToggleButton Name="ProblemsStripe" Classes="stripe" ToolTip.Tip="Problems" Tag="Problems" Click="OnBottomStripe">
                            <PathIcon Data="{StaticResource Icon.Problems}" />
                        </ToggleButton>
                        <ToggleButton Classes="stripe" ToolTip.Tip="Terminal">
                            <PathIcon Data="{StaticResource Icon.Terminal}" />
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The Explorer and the editors over the bottom tool windows. -->
            <Grid Name="Center" Grid.Column="1" RowDefinitions="*,0,0">
                <Grid Name="Upper" Grid.Row="0" ColumnDefinitions="280,1,*">
                    <explorer:ExplorerView Name="Explorer" Grid.Column="0" />
                    <!-- A 1 px line to see, under a wider invisible splitter to grab. -->
                    <Border Grid.Column="1" Background="{DynamicResource Passenger.Divider}" />
                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Classes="hairline" />
                    <editors:EditorArea Name="Editors" Grid.Column="2" />
                </Grid>
                <Panel Grid.Row="1">
                    <Border Background="{DynamicResource Passenger.Divider}" />
                    <GridSplitter ResizeDirection="Rows" Classes="hairlineRows" />
                </Panel>
                <tools:BottomPanel Name="Bottom" Grid.Row="2" />
            </Grid>

            <!-- The right stripe. -->
            <Border Grid.Column="2" Background="{DynamicResource Passenger.Chrome}"
                    BorderBrush="{DynamicResource Passenger.Divider}" BorderThickness="1,0,0,0">
                <StackPanel Margin="0,6" Spacing="4" HorizontalAlignment="Center">
                    <ToggleButton Classes="stripe" ToolTip.Tip="Notifications">
                        <PathIcon Data="{StaticResource Icon.Notifications}" />
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The status bar: where the caret is and how the file is stored. -->
        <Border Grid.Row="2" Height="26" Background="{DynamicResource Passenger.Chrome}"
                BorderBrush="{DynamicResource Passenger.Divider}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Name="CaretText" Classes="status" />
                    <TextBlock Name="LineEndingText" Classes="status" />
                    <TextBlock Name="EncodingText" Classes="status" />
                    <TextBlock Name="IndentText" Classes="status" />
                    <TextBlock Name="LanguageText" Classes="status" />
                </StackPanel>
                <TextBlock Name="StatusText" Classes="status" Text="No solution" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>

    <!-- Popups (Go to File, Go to Line) over everything; a click outside one dismisses it. -->
    <Panel Name="Overlay" IsVisible="False" Background="Transparent" PointerPressed="OnOverlayPressed">
        <ContentControl Name="OverlayHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0" />
    </Panel>
    </Panel>
</Window>
