<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Passenger.App"
             x:Class="Passenger.App.Navigation.GoToLinePopup"
             Width="{x:Static app:PopupFrame.Narrow}">
    <Border Classes="popup" Padding="12,10">
        <StackPanel Spacing="8">
            <TextBlock Classes="popupTitle" Text="Go to Line:Column" />
            <TextBox Name="Query" Classes="search" />
            <TextBlock Name="Problem" Classes="muted" FontSize="12" IsVisible="False" />
        </StackPanel>
    </Border>
</UserControl>
