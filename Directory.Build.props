<Project>
  <!-- What every project shares. A project's own file sets only what is its own. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- What a package says it is (tools/package-mac.sh) until a vX.Y.Z tag on the commit names the version. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Every build lands under artifacts/, never beside the sources. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Passenger is in English; Roslyn's translated messages would only add folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
