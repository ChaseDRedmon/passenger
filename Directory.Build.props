<Project>
  <!-- What every project shares. A project's own file sets only what is its own. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- What a package says it is (tools/package-mac.sh) until a vX.Y.Z tag on the commit names the version. -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Every build lands under artifacts/, never beside the sources. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <!-- Passenger is in English; Roslyn's translated messages would only add folders. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Each project's packages.lock.json pins every package, transitive ones included, to the content hash restored.
         A restore on a person's machine rewrites it when a package changes (commit it with the change); CI restores
         only what it names. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- The systems Passenger is published for (just publish, tools/package-mac.sh), so each lock file holds their
         packages too: a publish for one restores what is locked rather than writing new lock files, which CI's locked
         restore would refuse. Their runtime and host packs download only for a publish, never for a build for this
         machine, and ASP.NET Core's, which nothing here uses, never. A publish also builds every library for its system,
         so the Roslyn server it copies is that system's, not the publishing machine's. -->
    <RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <EnableRuntimePackDownload Condition="'$(RuntimeIdentifier)' == ''">false</EnableRuntimePackDownload>
    <EnableAppHostPackDownload Condition="'$(RuntimeIdentifier)' == ''">false</EnableAppHostPackDownload>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>
</Project>
