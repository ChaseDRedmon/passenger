<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A web app's graph on Npgsql's provider of EF Core with the Design package, as the test of a compose run's Postgres
       writes it; a library, with no Main, where the web SDK makes a program. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
