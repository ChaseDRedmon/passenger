<Project Sdk="Microsoft.NET.Sdk">

	<!-- ReadsInputConsoleApp's own Program.cs with CET's shadow stacks off (an apphost has them on since .NET 9): on x64
	     Windows the attach test lets this copy go at its breakpoint too when the other ends badly there, so its failure
	     says whether the shadow stacks are what end it. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CetCompat>false</CetCompat>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../ReadsInputConsoleApp/Program.cs" />
	</ItemGroup>

</Project>
